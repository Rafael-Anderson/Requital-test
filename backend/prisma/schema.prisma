generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model order {
  id                    Int                  @id @default(autoincrement())
  shopId                Int
  outletId              Int
  // Nullable: historical orders predating the Customer model, and orders
  // created before customer matching existed, are left null rather than
  // fuzzy-backfilled by guessing at a phone match — see CustomersService.
  customerId            Int?
  customerName          String
  customerPhone         String
  customerEmail         String?
  customerAddress       String               @db.Text
  emirate               String
  area                  String?
  deliveryDate          DateTime?
  deliveryTimeSlot      String?
  deliveryNotes         String?              @db.Text
  receiverMessage       String?              @db.Text
  channel               String?
  orderType             String?
  // How the customer intends to pay — set by the storefront checkout flow
  // ('card_online' | 'cash_on_delivery' | 'card_on_delivery' |
  // 'cash_on_pickup' | 'card_on_pickup'). Null for orders created before
  // this column existed or entered manually without a payment method.
  paymentMethod         String?
  status                String               @default("pending")
  paymentStatus         String               @default("unpaid")
  // Snapshotted at creation from the request or shop.defaultDeliveryFee at
  // that moment (same principle as orderitem.priceAtPurchase) — a later
  // change to the shop default never retroactively changes this order's
  // total. Null only for orders created before this column existed.
  deliveryFee           Decimal?
  // Tax amount in currency units, snapshotted at creation from shop.taxRate
  // at that moment (same snapshot principle as deliveryFee) — a later change
  // to the shop's tax rate never retroactively changes this order's total.
  // Null for orders created before this column existed or where tax wasn't
  // computed (e.g. manually entered admin orders).
  taxAmount             Decimal?
  // Snapshotted at redemption time — never null once a code was applied,
  // even if the discount itself is later edited/deactivated/deleted
  // (discountId goes SetNull, but discountCode/discountAmount preserve what
  // actually happened on this order, same principle as priceAtPurchase).
  discountId            Int?
  discountCode          String?
  discountAmount        Decimal?
  // Same snapshot discipline as discountId/discountCode/discountAmount
  // above — giftCardId goes SetNull if the card is ever deleted (it isn't,
  // today, but the precedent is consistent either way), giftCardCode/
  // giftCardAmount preserve what actually happened on this order regardless.
  // Exactly one gift card per order (a single code field, same UX shape as
  // discountCode) — amount applied is capped to min(remainingBalance, total)
  // at redemption time, see GiftCardsService.redeem.
  giftCardId            Int?
  giftCardCode          String?
  giftCardAmount        Decimal?
  total                 Decimal
  createdAt             DateTime             @default(now())
  paymentLinkToken      String?              @unique(map: "Order_paymentLinkToken_key")
  paymentLinkExpiresAt  DateTime?
  // Opaque short code handed to the customer at checkout (order ids are
  // sequential and must never be exposed as a lookup credential on their
  // own) — same plaintext-bearer-token shape as paymentLinkToken, since it's
  // the same threat model: possession of the code is what proves it's your
  // order, not a login. Generated for every order at creation, admin- and
  // storefront-created alike.
  trackingToken         String?              @unique(map: "Order_trackingToken_key")
  // Bill of Materials — set the moment ProductsService.consumeForOrderItems
  // actually decrements ingredient stock for this order (immediately at
  // creation for storefront/draft-order channels, at the pending->confirmed
  // transition otherwise — see that method's own comment). Null if nothing
  // was ever consumed, whether because no line item had a recipe or because
  // shop.autoDeductIngredientStock was off at that moment. Read back (not
  // re-derived from the toggle's *current* value) when cancelling, so a
  // merchant flipping the toggle mid-order-lifecycle can never cause a
  // restock that was never actually deducted, or skip a restock that was.
  ingredientsConsumedAt DateTime?
  shop                  shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "Order_shopId_fkey")
  outlet                outlet               @relation(fields: [outletId], references: [id], onDelete: Restrict, map: "Order_outletId_fkey")
  customer              customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull, map: "Order_customerId_fkey")
  discount              discount?            @relation(fields: [discountId], references: [id], onDelete: SetNull, map: "Order_discountId_fkey")
  giftcard              giftcard?            @relation("OrderGiftCardPayment", fields: [giftCardId], references: [id], onDelete: SetNull, map: "Order_giftCardId_fkey")
  orderitem             orderitem[]
  paymenttransaction    paymenttransaction[]
  externaldelivery      externaldelivery?
  affiliateorder        affiliateorder?
  discountredemption    discountredemption?
  draftorder            draftorder?
  ordernote             ordernote[]
  orderreturn           orderreturn[]
  invoice               invoice[]
  giftcardredemption    giftcardredemption[]
  giftcardissued        giftcard[]           @relation("GiftCardPurchaseOrder")
  abandonedcart         abandonedcart?
  surveyresponse        surveyresponse?

  @@index([shopId], map: "Order_shopId_fkey")
  @@index([discountId], map: "Order_discountId_fkey")
  @@index([giftCardId], map: "Order_giftCardId_fkey")
  @@index([shopId, status], map: "Order_shopId_status_idx")
  @@index([shopId, createdAt], map: "Order_shopId_createdAt_idx")
  @@index([outletId, status], map: "Order_outletId_status_idx")
  @@index([customerId], map: "Order_customerId_fkey")
}

// Staff-only, append-only note thread on an order — never surfaced on the
// public tracking page or anywhere PublicService reads from (a completely
// separate table nothing in src/public touches). A thread rather than a
// single overwritable textarea: multiple staff can leave notes over an
// order's lifetime without clobbering each other, and author+timestamp on
// each entry is the whole point of a note trail ("who said what, when").
model ordernote {
  id           Int      @id @default(autoincrement())
  orderId      Int
  authorUserId Int
  note         String   @db.Text
  createdAt    DateTime @default(now())
  order        order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderNote_orderId_fkey")
  author       user     @relation(fields: [authorUserId], references: [id], map: "OrderNote_authorUserId_fkey")

  @@index([orderId], map: "OrderNote_orderId_fkey")
  @@index([authorUserId], map: "OrderNote_authorUserId_fkey")
}

// Scoped deliberately, not "log every mutation" — price changes, status
// changes, staff logins, deletes, and the bulk actions from #2 (which are
// themselves just bulk status/delete/price under the hood, so they're
// covered by the same log calls, not a separate category). Inventory
// transfers/adjustments (#6/#10) are intentionally NOT duplicated here —
// stockmovement already is that domain's own actor+timestamp+reason trail,
// logging them again here would just be two logs for one action.
// `before`/`after` are JSON snapshots of only the field(s) that actually
// changed, not the whole entity — this is an audit trail, not a full
// version-control diff.
model auditlog {
  id          Int      @id @default(autoincrement())
  shopId      Int
  actorUserId Int
  action      String
  entityType  String
  entityId    Int?
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  shop        shop     @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "AuditLog_shopId_fkey")
  actor       user     @relation(fields: [actorUserId], references: [id], map: "AuditLog_actorUserId_fkey")

  @@index([shopId, createdAt], map: "AuditLog_shopId_createdAt_idx")
  @@index([shopId, entityType], map: "AuditLog_shopId_entityType_idx")
  @@index([shopId, actorUserId], map: "AuditLog_shopId_actorUserId_idx")
}

// Manual record of handing an order off to a third-party courier —
// deliberately NOT the same thing as Requital's own in-house delivery
// system (deliveryFee/deliveryRadiusKm/deliveryzone above). No real courier
// API integration exists; this is a merchant-entered log ("we sent order
// #123 via Careem, paid them 25 AED") — status here tracks the courier leg
// specifically and is independent of the order's own status. One record per
// order (an order either went out via an external courier or it didn't —
// not modeled as multiple courier attempts).
model externaldelivery {
  id          Int      @id @default(autoincrement())
  orderId     Int      @unique(map: "ExternalDelivery_orderId_key")
  carrier     String
  vehicleType String?
  // What the merchant paid the carrier for this delivery — distinct from
  // order.deliveryFee, which is what the *customer* was charged.
  price       Decimal
  destination String   @db.Text
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  order       order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "ExternalDelivery_orderId_fkey")
}

// Post-purchase survey, fired once when an order transitions to 'delivered'
// (see OrderNotificationsService.notifySurveyRequest), gated on
// shop.customerSurveyEnabled. `token` is an opaque plaintext bearer code
// (same threat model as order.trackingToken — possession proves it's your
// survey, not a login credential) emailed as a link to a public storefront
// page. One row per order (@unique orderId) — notifySurveyRequest checks for
// an existing row before creating one, so a delivered -> other -> delivered
// transition or a bulkUpdateStatus retry never sends a second email.
model surveyresponse {
  id          Int       @id @default(autoincrement())
  shopId      Int
  orderId     Int       @unique(map: "SurveyResponse_orderId_key")
  token       String    @unique(map: "SurveyResponse_token_key")
  rating      Int?
  comment     String?   @db.Text
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  shop        shop      @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "SurveyResponse_shopId_fkey")
  order       order     @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "SurveyResponse_orderId_fkey")

  @@index([shopId], map: "SurveyResponse_shopId_fkey")
}

model orderitem {
  id              Int               @id @default(autoincrement())
  orderId         Int
  productId       Int
  productName     String
  // Null for a non-variant product (unchanged behavior). Set for a
  // variant-bearing product — resolves price/sku at order time from the
  // variant, not the parent product. variantLabel is a snapshot (e.g.
  // "Small / Red"), same "never retroactively changes" principle as
  // priceAtPurchase — survives the variant itself later being deleted
  // (onDelete: SetNull) when options are edited.
  variantId       Int?
  variantLabel    String?
  quantity        Int
  priceAtPurchase Decimal
  // Optional note the customer typed on the product page at add-to-cart
  // time (e.g. "no card, please" for a florist order) — distinct from
  // deliveryNotes/ordernote, which are order-level, not per-line-item.
  note            String?           @db.VarChar(255)
  order           order             @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderItem_orderId_fkey")
  product         product           @relation(fields: [productId], references: [id], onDelete: Restrict, map: "OrderItem_productId_fkey")
  variant         productvariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull, map: "OrderItem_variantId_fkey")
  orderreturnitem orderreturnitem[]

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
  @@index([variantId], map: "OrderItem_variantId_fkey")
}

// One row per return/refund processed against an order — an order can have
// several (partial returns over time), each capped at the line-item level
// (see orderreturnitem) and, cumulatively across all of an order's returns,
// at order.total (enforced in ReturnsService, not the DB — same "app-layer
// running-total guard inside a transaction" style as the discount-redemption
// cap elsewhere in this schema).
model orderreturn {
  id                      Int               @id @default(autoincrement())
  orderId                 Int
  reason                  String
  refundAmount            Decimal
  // 'provider' (issued through the gateway's refund API) or 'manual' (cash/
  // recorded-only — either because the gateway has no refundPayment support,
  // or because the API call itself failed) — always recorded, per the task's
  // own "always record which happened" requirement.
  refundMethod            String
  providerRefundReference String?
  // The portion of refundAmount credited back to order.giftcard's balance
  // rather than sent through the payment provider — proportional to how the
  // order was originally split (order.giftCardAmount / order.total) at the
  // time this return was created, so a full return correctly reverses both
  // portions and a partial return splits fairly. Never touches a provider
  // refund call for this slice — see ReturnsService.attemptProviderRefund,
  // which is only ever asked to refund refundAmount - giftCardRefundAmount.
  // 0 (not null) for the common case of an order with no gift card involved.
  giftCardRefundAmount    Decimal           @default(0)
  restocked               Boolean           @default(false)
  status                  String            @default("completed")
  staffUserId             Int
  createdAt               DateTime          @default(now())
  order                   order             @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderReturn_orderId_fkey")
  staff                   user              @relation(fields: [staffUserId], references: [id], map: "OrderReturn_staffUserId_fkey")
  orderreturnitem         orderreturnitem[]

  @@index([orderId], map: "OrderReturn_orderId_fkey")
  @@index([staffUserId], map: "OrderReturn_staffUserId_fkey")
}

model orderreturnitem {
  id            Int         @id @default(autoincrement())
  orderReturnId Int
  orderItemId   Int
  quantity      Int
  orderreturn   orderreturn @relation(fields: [orderReturnId], references: [id], onDelete: Cascade, map: "OrderReturnItem_orderReturnId_fkey")
  orderitem     orderitem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict, map: "OrderReturnItem_orderItemId_fkey")

  @@index([orderReturnId], map: "OrderReturnItem_orderReturnId_fkey")
  @@index([orderItemId], map: "OrderReturnItem_orderItemId_fkey")
}

// One row per (order, type) — an order can have both an INVOICE and a
// PACKING_SLIP generated independently, never two of the same type
// (@@unique enforces the idempotent-generate contract InvoicesService relies
// on). subtotal/taxAmount/total are snapshotted at generation time from the
// order's own totals, same "never retroactively changes" discipline as
// orderitem.priceAtPurchase — a later change to the order (a return, a price
// edit) doesn't rewrite an already-issued invoice.
model invoice {
  id            Int      @id @default(autoincrement())
  orderId       Int
  shopId        Int
  // 'INVOICE' | 'PACKING_SLIP' — plain string, not a Prisma enum, matching
  // every other small-fixed-set field in this schema (validated with
  // @IsIn at the DTO layer instead).
  type          String
  invoiceNumber String
  issuedAt      DateTime @default(now())
  subtotal      Decimal
  taxAmount     Decimal
  total         Decimal
  notes         String?  @db.Text
  order         order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "Invoice_orderId_fkey")
  shop          shop     @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "Invoice_shopId_fkey")

  @@unique([orderId, type], map: "Invoice_orderId_type_key")
  @@index([shopId], map: "Invoice_shopId_fkey")
}

// Backing counter for invoiceNumber, one row per (shop, type) so a shop's
// INVOICE and PACKING_SLIP sequences run independently and never collide
// with another shop's. Incremented via a raw `INSERT ... ON DUPLICATE KEY
// UPDATE ... LAST_INSERT_ID(...)` (see InvoicesService.nextInvoiceNumber) —
// that statement is atomic in MySQL (the row lock it takes serializes
// concurrent callers), which a Prisma-level upsert-then-read is not
// guaranteed to be.
model invoicecounter {
  shopId     Int
  type       String
  lastNumber Int    @default(0)
  shop       shop   @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "InvoiceCounter_shopId_fkey")

  @@id([shopId, type])
}

model paymenttransaction {
  id                      Int      @id @default(autoincrement())
  orderId                 Int
  gateway                 String
  gatewayReference        String
  // The charge/payment-intent id (distinct from gatewayReference, which is
  // the webhook event id) — see WebhookResult.chargeReference's own comment.
  // Null for providers that don't report one (pre-existing rows, or
  // providers without refund support).
  providerChargeReference String?
  amount                  Decimal
  status                  String   @default("pending")
  createdAt               DateTime @default(now())
  order                   order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "PaymentTransaction_orderId_fkey")

  @@unique([gateway, gatewayReference], map: "PaymentTransaction_gateway_gatewayReference_key")
  @@index([orderId], map: "PaymentTransaction_orderId_fkey")
}

model product {
  id                        Int                 @id @default(autoincrement())
  shopId                    Int
  name                      String
  // All three were the default Prisma VARCHAR(191) — a real product
  // description regularly exceeds that (caught by seo.e2e-spec.ts's
  // metadata-fallback test). Widened to TEXT; shortSummary too even though
  // its name suggests brevity — nothing actually enforces a length limit on
  // it (no MaxLength in the DTOs), so it was just as exposed to the same bug.
  description               String?             @db.Text
  shortSummary              String?             @db.Text
  longSummary               String?             @db.Text
  thumbnail                 String
  price                     Decimal
  // Shown struck-through next to price as a "was" price when set — purely
  // display, never used in order total math (see orderitem.priceAtPurchase).
  compareAtPrice            Decimal?
  costPrice                 Decimal?
  sku                       String
  barcode                   String?
  status                    String              @default("Available")
  trackInventory            Boolean             @default(false)
  // Whether checkout still accepts orders once trackInventory'd stock hits
  // zero — mirrors Shopify's "continue selling when out of stock".
  continueSellingOutOfStock Boolean             @default(false)
  chargeTax                 Boolean             @default(true)
  // When true, offered in the storefront checkout's "would you like to add
  // any extras?" popup for carts that don't already contain it.
  isCheckoutAddon           Boolean             @default(false)
  // Per-product opt-in for the Variants/Attributes/FAQs sections of the
  // admin product form (see VariantsSection/AttributesSection/FaqsSection) —
  // replaces the old shop-wide productVariantsEnabled/productAttributesEnabled/
  // productFaqsEnabled toggles. A new product defaults these to whatever
  // shop.productEditorMode implies client-side (false for 'simple', true for
  // 'advanced'); once saved, the merchant's per-product choice is what
  // persists here regardless of the shop's current mode. showAttributes/
  // showFaqs also gate whether the storefront PDP renders those sections at
  // all — see ProductDetailClient.tsx.
  showVariants              Boolean             @default(false)
  showAttributes            Boolean             @default(false)
  showFaqs                  Boolean             @default(false)
  // Gift Cards feature — a product with isGiftCard: true is sold like any
  // other product (same cart/checkout path, own `price` field ignored in
  // favor of whichever denomination/custom amount the shopper picks), but
  // on order creation each unit generates a real giftcard row instead of
  // being fulfilled physically — see PublicService.createOrder and
  // GiftCardsService.issueForOrder. Config lives directly on product rather
  // than a separate one-row-per-gift-card-product table: three small
  // optional fields don't earn their own model, same reasoning as the
  // shipping/physicalProduct fields above.
  isGiftCard                Boolean             @default(false)
  // Preset amounts a shopper can pick, e.g. [100, 200, 500] — plain number[]
  // JSON, no dedicated table (nothing else ever queries "shops offering a
  // 200 AED gift card").
  giftCardDenominations     Json?
  giftCardCustomAmountMin   Decimal?
  giftCardCustomAmountMax   Decimal?
  // Organization sidebar fields — free text, no dedicated lookup tables
  // (matches how tag/category already work: shop-scoped, no cross-shop
  // sharing). Collections were explicitly out of scope (no such model exists
  // in this schema; task said to flag rather than build one from scratch).
  vendor                    String?
  productType               String?
  // Shipping — physicalProduct off hides weight/dimensions in the UI; a
  // single free-text dimensions field rather than Shopify's full
  // package-profile system (explicitly descoped in the task).
  physicalProduct           Boolean             @default(true)
  weight                    Decimal?
  weightUnit                String              @default("kg")
  dimensions                String?
  createdAt                 DateTime            @default(now())
  // Storefront product-detail URL segment — auto-derived from name if not
  // explicitly set (see ProductsService.resolveUniqueSlug), editable after.
  // Unlike sku, name collisions are common (two "Chocolate Cake" products),
  // so auto-generation disambiguates with a numeric suffix rather than
  // failing; an explicitly-chosen slug that collides still hard-rejects,
  // same as category slugs.
  slug                      String
  metaTitle                 String?
  metaDescription           String?             @db.Text
  shop                      shop                @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "Product_shopId_fkey")
  productvariant            productvariant[]
  productimage              productimage[]
  productattribute          productattribute[]
  productfaq                productfaq[]
  productoption             productoption[]
  productcategory           productcategory[]
  producttag                producttag[]
  orderitem                 orderitem[]
  outletstock               outletstock[]
  biolink                   biolink[]
  discountproduct           discountproduct[]
  draftorderitem            draftorderitem[]
  stockmovement             stockmovement[]
  collectionproduct         collectionproduct[]
  productingredient         productingredient[]
  notifysubscription        notifysubscription[]

  @@unique([shopId, sku], map: "Product_shopId_sku_key")
  @@unique([shopId, slug], map: "Product_shopId_slug_key")
}

// Back-in-stock "notify me" subscriptions, storefront-facing (no auth — any
// shopper can subscribe with just an email). variantId is null for a
// product-level subscription (no variants, or "notify for any variant") and
// set for a specific out-of-stock variant. notifiedAt stays null until
// NotifySubscriptionsService.triggerForProduct actually sends the restock
// email — re-triggering (e.g. stock flaps 0->1->0->1) never re-notifies a
// row that's already been notified once.
model notifysubscription {
  id         Int              @id @default(autoincrement())
  shopId     Int
  productId  Int
  variantId  Int?
  email      String
  createdAt  DateTime         @default(now())
  notifiedAt DateTime?
  shop       shop             @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "NotifySubscription_shopId_fkey")
  product    product          @relation(fields: [productId], references: [id], onDelete: Cascade, map: "NotifySubscription_productId_fkey")
  variant    productvariant?  @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "NotifySubscription_variantId_fkey")

  // MySQL treats NULL as distinct in a unique index, so two subscriptions
  // for the same (shopId, productId, email) with variantId both NULL are
  // still correctly deduped; two different variants of the same product for
  // the same email are correctly allowed as separate rows.
  @@unique([shopId, productId, variantId, email], map: "NotifySubscription_unique")
  @@index([shopId, email, createdAt], map: "NotifySubscription_rateLimit_idx")
  @@index([productId], map: "NotifySubscription_productId_fkey")
  @@index([variantId], map: "NotifySubscription_variantId_fkey")
}

// Media gallery. product.thumbnail stays the source of truth for every
// existing consumer (cart, order items, bio links, storefront listings) and
// is kept in sync to this list's first (order: 0) row by ProductsService —
// avoids touching every place that already reads product.thumbnail directly.
// A product with no productimage rows (every product created before this
// feature) just has an empty gallery and relies on product.thumbnail alone,
// exactly like today.
model productimage {
  id             Int              @id @default(autoincrement())
  productId      Int
  url            String
  order          Int              @default(0)
  product        product          @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductImage_productId_fkey")
  productvariant productvariant[]

  @@index([productId], map: "ProductImage_productId_fkey")
}

// Informational, non-purchasable product facts (e.g. Material: Cotton) —
// deliberately NOT productoption/productoptionvalue, which are purchasable
// variant axes that generate real productvariant rows with their own
// price/stock/sku. An attribute never does that — it's a plain ordered list
// off product, structurally like productimage above, full-replace on
// product update (see ProductsService).
model productattribute {
  id        Int     @id @default(autoincrement())
  productId Int
  name      String
  value     String
  order     Int     @default(0)
  product   product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductAttribute_productId_fkey")

  @@index([productId], map: "ProductAttribute_productId_fkey")
}

// Per-product FAQ list (question/answer pairs), admin-editable, rendered on
// the storefront PDP when shop.productFaqsEnabled is on. Same full-replace-
// on-update convention as productattribute/productimage.
model productfaq {
  id        Int     @id @default(autoincrement())
  productId Int
  question  String
  answer    String  @db.Text
  order     Int     @default(0)
  product   product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductFaq_productId_fkey")

  @@index([productId], map: "ProductFaq_productId_fkey")
}

// A product with zero productoption rows behaves exactly as before this
// feature existed (single implicit variant — product-level price/sku/
// outletstock). Options only appear once a merchant explicitly adds one via
// PUT /products/:id/options.
model productoption {
  id                 Int                  @id @default(autoincrement())
  productId          Int
  name               String
  order              Int                  @default(0)
  product            product              @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductOption_productId_fkey")
  productoptionvalue productoptionvalue[]

  @@index([productId], map: "ProductOption_productId_fkey")
}

model productoptionvalue {
  id                Int              @id @default(autoincrement())
  optionId          Int
  value             String
  order             Int              @default(0)
  productoption     productoption    @relation(fields: [optionId], references: [id], onDelete: Cascade, map: "ProductOptionValue_optionId_fkey")
  variantsAsOption1 productvariant[] @relation("VariantOptionValue1")
  variantsAsOption2 productvariant[] @relation("VariantOptionValue2")
  variantsAsOption3 productvariant[] @relation("VariantOptionValue3")

  @@index([optionId], map: "ProductOptionValue_optionId_fkey")
}

model category {
  id               Int                @id @default(autoincrement())
  shopId           Int
  name             String
  slug             String
  displayOrder     Int                @default(0)
  image            String?
  isFeatured       Boolean            @default(false)
  parentCategoryId Int?
  createdAt        DateTime           @default(now())
  shop             shop               @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "Category_shopId_fkey")
  parent           category?          @relation("CategoryToParent", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Category_parentCategoryId_fkey")
  children         category[]         @relation("CategoryToParent")
  productcategory  productcategory[]
  biolink          biolink[]
  discountcategory discountcategory[]

  @@unique([shopId, slug], map: "Category_shopId_slug_key")
  @@index([shopId], map: "Category_shopId_fkey")
  @@index([parentCategoryId], map: "Category_parentCategoryId_fkey")
}

model productcategory {
  productId  Int
  categoryId Int
  product    product  @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductCategory_productId_fkey")
  category   category @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "ProductCategory_categoryId_fkey")

  @@id([productId, categoryId])
  @@index([categoryId], map: "ProductCategory_categoryId_fkey")
}

model tag {
  id         Int          @id @default(autoincrement())
  shopId     Int
  name       String
  shop       shop         @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "Tag_shopId_fkey")
  producttag producttag[]

  @@unique([shopId, name], map: "Tag_shopId_name_key")
}

model producttag {
  productId Int
  tagId     Int
  product   product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductTag_productId_fkey")
  tag       tag     @relation(fields: [tagId], references: [id], onDelete: Cascade, map: "ProductTag_tagId_fkey")

  @@id([productId, tagId])
  @@index([tagId], map: "ProductTag_tagId_fkey")
}

// Redesigned from an unused stub (no sku/options, never referenced by any
// service code) into the real per-combination row Shopify-parity variants
// need. option1/2/3 columns (not a join table) mirror Shopify's own model —
// up to 3 options per product, enforced in ProductsService, not here.
// price/compareAtPrice/sku/barcode/weight null = "not overridden, falls back
// to the parent product's own field" for a newly-generated variant that
// hasn't been individually edited yet.
model productvariant {
  id                 Int                  @id @default(autoincrement())
  productId          Int
  sku                String?
  barcode            String?
  price              Decimal?
  compareAtPrice     Decimal?
  weight             Decimal?
  imageId            Int?
  order              Int                  @default(0)
  optionValue1Id     Int?
  optionValue2Id     Int?
  optionValue3Id     Int?
  createdAt          DateTime             @default(now())
  product            product              @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductVariant_productId_fkey")
  image              productimage?        @relation(fields: [imageId], references: [id], onDelete: SetNull, map: "ProductVariant_imageId_fkey")
  optionValue1       productoptionvalue?  @relation("VariantOptionValue1", fields: [optionValue1Id], references: [id], onDelete: SetNull, map: "ProductVariant_optionValue1Id_fkey")
  optionValue2       productoptionvalue?  @relation("VariantOptionValue2", fields: [optionValue2Id], references: [id], onDelete: SetNull, map: "ProductVariant_optionValue2Id_fkey")
  optionValue3       productoptionvalue?  @relation("VariantOptionValue3", fields: [optionValue3Id], references: [id], onDelete: SetNull, map: "ProductVariant_optionValue3Id_fkey")
  outletvariantstock outletvariantstock[]
  orderitem          orderitem[]
  draftorderitem     draftorderitem[]
  stockmovement      stockmovement[]
  productingredient  productingredient[]
  notifysubscription notifysubscription[]

  @@unique([productId, optionValue1Id, optionValue2Id, optionValue3Id], map: "ProductVariant_combination_key")
  @@index([productId], map: "ProductVariant_productId_fkey")
  @@index([imageId], map: "ProductVariant_imageId_fkey")
  @@index([optionValue1Id], map: "ProductVariant_optionValue1Id_fkey")
  @@index([optionValue2Id], map: "ProductVariant_optionValue2Id_fkey")
  @@index([optionValue3Id], map: "ProductVariant_optionValue3Id_fkey")
}

// Per-outlet stock for a variant-bearing product — parallel to outletstock
// (product-level), not an overload of it: a variant product's rows live
// here keyed by variantId instead, so the two never collide and every
// existing outletstock caller (bulk-adjust, order creation for non-variant
// products) stays untouched.
model outletvariantstock {
  outletId          Int
  variantId         Int
  stockQuantity     Int            @default(0)
  // Nullable, no default — null means "no alert configured" (off), not
  // "alert at 0." Per-outlet, not per-product-total: a merchant needs to
  // know a *specific branch* is running low, not that a sum across five
  // branches dipped — see the Low Stock Alerts task's own reasoning. See
  // ProductsService.setLowStockThreshold for the write path (there's no
  // dedicated admin UI field elsewhere; this was previously a dead,
  // always-0 column with no way to ever set it away from the default).
  lowStockThreshold Int?
  outlet            outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade, map: "OutletVariantStock_outletId_fkey")
  variant           productvariant @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "OutletVariantStock_variantId_fkey")

  @@id([outletId, variantId])
  @@index([variantId], map: "OutletVariantStock_variantId_fkey")
}

model shop {
  id                         Int       @id @default(autoincrement())
  name                       String
  subdomain                  String    @unique(map: "Shop_subdomain_key")
  currency                   String    @default("AED")
  createdAt                  DateTime  @default(now())
  // Gates storefront visibility (see PublicService/PublicController) and the
  // platform sitemap. Defaults false for new signups — a merchant must take
  // the explicit "Publish your store" action (Settings > Business
  // Information) once they've done minimum setup. Existing shops were
  // backfilled by the migration itself, not left false by this default — see
  // that migration's comment for the exact backfill rule.
  published                  Boolean   @default(false)
  // Added specifically so the platform sitemap has a real lastmod value
  // (see PublicService.listShopsForSitemap) — reflects when this shop row
  // itself last changed, not a full aggregate over its products/theme/etc.
  updatedAt                  DateTime  @default(now()) @updatedAt
  displayName                String?
  legalName                  String?
  trademarkFormat            String    @default("brand")
  logoUrl                    String?
  email                      String?
  whatsappCountryCode        String?
  whatsappNumber             String?
  description                String?   @db.Text
  country                    String?
  address                    String?   @db.Text
  timezone                   String    @default("Asia/Dubai")
  notifyWhatsapp             Boolean   @default(false)
  notifyCustomersWhatsapp    Boolean   @default(false)
  notifyEmail                Boolean   @default(false)
  // Abandoned Cart Recovery — off by default (this emails a potential
  // customer who never completed a purchase, not an existing one, so it
  // gets its own deliberate opt-in rather than riding on notifyEmail).
  // windowMinutes is configurable per shop since "abandoned" is a merchant
  // judgment call (a florist doing same-day orders might want 30 minutes; a
  // shop with a long deliberate checkout might want 24 hours) — see
  // AbandonedCartsService.
  notifyAbandonedCart        Boolean   @default(false)
  abandonedCartWindowMinutes Int       @default(60)
  // Low Stock digest — a scheduled daily summary, not real-time per-item
  // email (see LowStockDigestService). lastSentAt is the send-once-per-day
  // guard, set via the same CAS updateMany discipline as everything else in
  // this schema that must never double-fire.
  notifyLowStockDigest       Boolean   @default(false)
  lowStockDigestLastSentAt   DateTime?
  // Bill of Materials (recipe) — gates whether ProductsService.consumeForOrderItems
  // actually touches outletingredientstock at order creation/confirmation, or
  // just leaves the linked recipe data as informational bookkeeping. On by
  // default (unlike the notify* toggles above): this doesn't send anything
  // to a customer, it's a stock-accuracy correction most merchants who
  // bother linking a recipe at all will want live immediately, not a second
  // opt-in step. See order.ingredientsConsumedAt for how a mid-order-lifecycle
  // flip of this toggle is handled without corrupting ingredient stock.
  autoDeductIngredientStock  Boolean   @default(true)
  // AES-256-GCM encrypted JSON { phoneNumberId, accessToken } for the Meta
  // WhatsApp Cloud API — same encrypt()/decrypt() from common/crypto.ts as
  // payment-gateway credentials (see shoppaymentprovider.credentials), not a
  // second encryption scheme. One shop-level slot rather than a
  // shoppaymentprovider-style per-provider table: unlike payment gateways,
  // there's exactly one pluggable WhatsAppProvider implementation, not a
  // merchant choice among several. Null means "not configured" — see
  // WhatsAppSettingsService/order-notifications.service.ts's stub fallback.
  whatsappCredentials        String?   @db.Text

  // Collected on the merchant Account Setup wizard's Business/Location steps
  // (admin/lib/useAccountSetupForm.ts) — businessType and address (above)
  // are also editable later via Business Settings, these three are wizard-only.
  trn                        String?
  websiteUrl                 String?
  operatingModel             String?
  branchCount                String?

  // --- Store Configuration: functional, actually wired into behavior ---
  businessType                  String?
  defaultLanguage               String  @default("en")
  defaultDeliveryFee            Decimal @default(0)
  taxDisplayText                String?
  productDisplayOrientation     String  @default("grid")
  productImageZoomEnabled       Boolean @default(true)
  showCategoryMenu              Boolean @default(true)
  allowPreOrders                Boolean @default(false)
  customerConfirmationRequired  Boolean @default(false)
  externalDeliveryEnabled       Boolean @default(false)
  asapDeliveryEnabled           Boolean @default(false)
  deliveryCalendarEnabled       Boolean @default(false)
  // JSON map of day -> { open, close, closed }, e.g. {"mon":{"open":"09:00","close":"18:00","closed":false},...}
  businessHours                 String? @db.Text
  whatsappFloatingButtonEnabled Boolean @default(false)
  birthdayDiscountEnabled       Boolean @default(false)

  // Which admin product-form experience this shop's merchants get — 'simple'
  // (3-step wizard, Variants/Attributes/FAQs opt-in per product via
  // ProductForm.tsx) or 'advanced' (single scrollable page, those same three
  // sections visible-but-collapsed by default). Set on the Account Setup
  // wizard's Review step, editable later in Settings > Business Information.
  // Only controls the product form's *starting* state client-side — see
  // product.showVariants/showAttributes/showFaqs below for the actual
  // per-product opt-in this used to be a shop-wide toggle for. Plain String
  // ('simple' | 'advanced'), not a Prisma enum — this schema has no Prisma
  // enums anywhere (see the biolink model's own comment on this convention).
  productEditorMode String @default("simple")
  // Gates whether a delivered order triggers the post-purchase survey email
  // — see OrdersService.updateStatus / OrderNotificationsService.notifySurveyRequest.
  customerSurveyEnabled    Boolean @default(false)
  // When true, the storefront cart/checkout is replaced by cartDisabledMode's
  // flow — see storefront ProductDetailClient.tsx and TopBar.tsx.
  disableStoreCart         Boolean @default(false)
  // Only meaningful when disableStoreCart is true. "buy_now": Add to Cart
  // becomes a single-item Buy Now that skips straight to checkout.
  // "contact_to_order": Add to Cart is replaced by a WhatsApp/contact CTA and
  // no checkout path is exposed at all. App-level validated (see
  // UpdateShopDto's @IsIn) rather than a DB enum — two short string values
  // don't earn a dedicated enum type.
  cartDisabledMode         String  @default("buy_now")

  // --- Store Configuration: placeholder preferences only — the underlying
  // feature doesn't exist yet, so toggling has no effect. ---
  dynamicThemeBuilderEnabled Boolean @default(false)

  // --- Online Presence ---
  // platform -> URL, e.g. {"instagram":"https://instagram.com/..."}. Only
  // toggled-on platforms have a key. No storefront exists yet to render
  // these into — this only persists the data for when it does.
  socialLinks Json?

  // Which PaymentProvider implementation backs "Pay online" checkout sessions
  // for this shop — a business-level choice (some UAE merchants want a local
  // gateway instead of Stripe), resolved by PaymentProviderRegistry at call
  // time. Distinct from the deliveryPayment*/pickupPayment* booleans below,
  // which are payment *methods* (card/cash/etc.), not the *gateway* behind
  // "card online" specifically.
  paymentGateway String @default("stripe")

  // --- Delivery & Pickup: business-level, shared across every outlet ---
  // (each outlet only has its own on/off toggle + delivery radius/zones —
  // see the outlet model). At least one payment method per context is
  // enforced in ShopService, not expressible as a plain column constraint.
  deliveryPaymentCardOnline     Boolean @default(true)
  deliveryPaymentCashOnDelivery Boolean @default(true)
  deliveryPaymentCardOnDelivery Boolean @default(false)
  pickupPaymentCardOnline       Boolean @default(true)
  pickupPaymentCashOnPickup     Boolean @default(true)
  pickupPaymentCardOnPickup     Boolean @default(false)

  // Independent of shop.businessHours (store hours) and of each other —
  // same day -> {open,close,closed} shape, reusing the BusinessHoursEditor
  // component on the frontend for all three.
  deliveryHours Json?
  pickupHours   Json?

  deliveryTimeSlotGapMinutes                 Int @default(60)
  deliveryPreparationTimeMinutes             Int @default(15)
  // Entered independently, not derived from the field above — source data
  // (Dukany reference) shows this as its own input, not a computed sum.
  deliveryPreparationPlusDeliveryTimeMinutes Int @default(45)

  // Range shown to customers on the order-tracking page.
  estimatedDeliveryTimeFrom Int    @default(30)
  estimatedDeliveryTimeTo   Int    @default(60)
  estimatedDeliveryTimeUnit String @default("minutes")

  pickupTimeSlotGapMinutes         Int @default(30)
  pickupPreparationTimeMinutes     Int @default(15)
  pickupPreparationPlusTimeMinutes Int @default(30)

  // --- Order Setting: business-level, shared across every outlet ---
  allowSameDayOrders Boolean @default(true)
  allowNextDayOrders Boolean @default(true)
  taxRate            Decimal @default(0) @db.Decimal(5, 2)
  // true = prices shown already include tax ("Inclusive"); false = tax is
  // added on top ("Exclusive"). Display-only, same as taxDisplayText — no
  // checkout exists yet to actually apply either rate.
  taxInclusive       Boolean @default(true)

  order               order[]
  product             product[]
  category            category[]
  tag                 tag[]
  themesettings       themesettings?
  shopseosettings     shopseosettings?
  user                user[]
  outlet              outlet[]
  customer            customer[]
  shoppaymentprovider shoppaymentprovider[]
  affiliate           affiliate[]
  affiliatecode       affiliatecode[]
  affiliateorder      affiliateorder[]
  biolink             biolink[]
  biolinkpageconfig   biolinkpageconfig?
  discount            discount[]
  draftorder          draftorder[]
  stockmovement       stockmovement[]
  auditlog            auditlog[]
  ingredient          ingredient[]
  ingredientcategory  ingredientcategory[]
  branchrole          branchrole[]
  collection          collection[]
  scansettings        scansettings?
  abandonedcart       abandonedcart[]
  giftcard            giftcard[]
  scanbatch           scanbatch[]
  productingredient   productingredient[]
  policypage          policypage[]
  bannerimage         bannerimage[]
  surveyresponse      surveyresponse[]
  invoice             invoice[]
  invoicecounter      invoicecounter[]
  notifysubscription  notifysubscription[]
}

// Legal/policy pages (Terms, Privacy, Refund & Return, Payment, Shipping &
// Delivery) — admin-editable rich text, publicly viewable at a real URL, one
// row per (shop, type). A merchant who hasn't written one yet simply has no
// row for that type; the footer hides that specific link rather than
// showing a broken/empty page (see storefront Footer.tsx) — no placeholder
// row, no "draft" state, since there's nothing to draft until they write
// something.
model policypage {
  id        Int      @id @default(autoincrement())
  shopId    Int
  // 'TERMS' | 'PRIVACY' | 'REFUND' | 'PAYMENT' | 'SHIPPING'
  type      String
  content   String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt
  shop      shop     @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "PolicyPage_shopId_fkey")

  @@unique([shopId, type], map: "PolicyPage_shopId_type_key")
}

// Real multi-image homepage slideshow banners — replaces themesettings.
// bannerUrl's single-image stand-in for the "Slideshow" homepage layout
// (which previously just cycled the one banner plus product thumbnails, see
// components/home-layouts/SlideshowHero.tsx). Relates directly to `shop`,
// not `themesettings` — a themesettings row is created lazily on first save
// (see ThemeService.upsert's upsert-on-any-field behavior) and banners
// shouldn't depend on that row existing first. Existing single banners are
// migrated into this table as order-0 rows (see this feature's own
// migration.sql) rather than losing that data.
model bannerimage {
  id      Int     @id @default(autoincrement())
  shopId  Int
  url     String
  // Optional per-slide CTA — clicking the slide navigates here if set,
  // otherwise the slide is just an image (no link).
  linkUrl String?
  order   Int     @default(0)
  shop    shop    @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "BannerImage_shopId_fkey")
}

// Link-in-bio page (Dukany parity) — a per-shop, publicly shareable list of
// links at storefront /:shopSlug/bio. `type` picks which of
// url/productId/categoryId/socialPlatform is meaningful; the other three are
// always null (enforced in BioLinksService, not a DB constraint — same
// convention as every other discriminated-field model in this schema, e.g.
// shoppaymentprovider's provider-keyed credentials). Plain String columns
// for type/socialPlatform rather than a Prisma `enum` — this schema has no
// Prisma enums anywhere (order.status, shop.paymentGateway, etc. are all
// plain strings with the union documented in a comment), so this follows
// that established convention rather than introducing a new one.
model biolink {
  id             Int         @id @default(autoincrement())
  shopId         Int
  // 'EXTERNAL_URL' | 'PRODUCT' | 'CATEGORY' | 'COLLECTION' | 'SOCIAL_ICON'
  type           String
  // Display text. Not required for SOCIAL_ICON (falls back to the platform's
  // display name at read time — see BioLinksService.resolveDisplayLabel).
  label          String?
  // EXTERNAL_URL only.
  url            String?     @db.Text
  // PRODUCT only. Deliberately SetNull (not Cascade) on product deletion —
  // the bio link row survives so the merchant sees it in the admin list
  // (still 'active', just no longer resolvable), rather than silently
  // vanishing; it's excluded from the public list/click endpoints once
  // productId is null. See the task's own "hide from public, stays active
  // in admin" default.
  productId      Int?
  // CATEGORY only. Same SetNull reasoning as productId.
  categoryId     Int?
  // COLLECTION only. Same SetNull reasoning as productId.
  collectionId   Int?
  // SOCIAL_ICON only — one of BIO_LINK_SOCIAL_PLATFORMS (bio-link-constants.ts).
  // No URL is stored here: the actual link is resolved at click time from
  // shop.socialLinks[socialPlatform], or from shop.whatsappNumber for the
  // 'whatsapp' platform specifically — reusing what the merchant already
  // configured on Online Presence rather than asking them to paste the same
  // URL twice. See BioLinksService.resolveSocialUrl.
  socialPlatform String?
  // Position in the storefront list — 0-based, unique-ish per shop but not
  // DB-enforced (PATCH .../reorder rewrites every row's value together in
  // one transaction, so a stale duplicate is never observable in between).
  order          Int         @default(0)
  active         Boolean     @default(true)
  clickCount     Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  shop           shop        @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "BioLink_shopId_fkey")
  product        product?    @relation(fields: [productId], references: [id], onDelete: SetNull, map: "BioLink_productId_fkey")
  category       category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "BioLink_categoryId_fkey")
  collection     collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull, map: "BioLink_collectionId_fkey")

  @@index([shopId], map: "BioLink_shopId_fkey")
  @@index([productId], map: "BioLink_productId_fkey")
  @@index([categoryId], map: "BioLink_categoryId_fkey")
  @@index([collectionId], map: "BioLink_collectionId_fkey")
}

// Page-level config for the bio-link page (/:shopSlug/bio), decoupled from
// the core shop row — same 1:1-table convention as themesettings/
// shopseosettings, not a batch of shop.bioPage* columns. Field names have no
// "bioPage" prefix within the table for the same reason themesettings.logoUrl
// isn't themeLogoUrl — the table itself already gives that context. One row
// or none (no row = nothing customized yet, same "valid absent state" as
// Theme/SEO — see BioLinksService.getPageConfig).
//
// Deliberately NOT a fallback-resolving table: every field here is the raw
// bio-specific override only. The "falls back to Theme's logo/banner, or the
// shop's general SEO meta" chain is resolved storefront-side (see
// storefront/lib/bio-page.ts and lib/seo.ts's buildBioPageMetadata) by
// reusing fields the existing GET /public/:shopSlug response already
// resolves (shop.logoUrl, shop.bannerUrl, shop.metaTitle, ...) — not
// duplicated here.
model biolinkpageconfig {
  id              Int     @id @default(autoincrement())
  shopId          Int     @unique(map: "BioLinkPageConfig_shopId_key")
  logoUrl         String?
  backgroundUrl   String?
  description     String? @db.Text
  metaTitle       String?
  metaDescription String? @db.Text
  shop            shop    @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "BioLinkPageConfig_shopId_fkey")
}

// Marketing-driven product groupings that cut across the category tree
// ("Summer Sale", "New Arrivals", "Under 50 AED") — deliberately a real,
// separate model from `category` rather than a Product boolean/tag array.
// Decision (see the task this was built under): a lightweight
// tag/boolean alternative was evaluated first and rejected because the two
// concrete capabilities actually asked for — RULE_BASED dynamic membership
// (auto-include by category/tag/price/recency) and MANUAL per-product
// ordering within the group — can't be expressed by a static tag without
// effectively rebuilding a worse version of this model anyway (a tag has no
// order field, and "auto-update membership as prices change" needs real
// query-time rule evaluation, not a value someone remembers to reapply).
// Categories stay a single hierarchical taxonomy for browse navigation;
// mixing one-off campaigns into that tree (a "Summer Sale" sibling of
// "Bouquets") would pollute it for every merchant who doesn't use collections.
model collection {
  id                Int                 @id @default(autoincrement())
  shopId            Int
  title             String
  slug              String
  description       String?             @db.Text
  image             String?
  // 'MANUAL' | 'RULE_BASED' — MANUAL membership lives in collectionproduct
  // (with per-product sortOrder); RULE_BASED has no collectionproduct rows
  // at all, membership is computed at read time from `rules` against the
  // live product table (see CollectionsService.resolveProductIds).
  type              String
  // RULE_BASED only, null for MANUAL. Shape: { categoryId?, tagName?,
  // minPrice?, maxPrice?, createdWithinDays? } — every set field is ANDed.
  // Deliberately this small, fixed shape (not a generic condition-builder)
  // — it's enough to express every example the task named ("Summer Sale" =
  // tagName, "New Arrivals" = createdWithinDays, "Under 50 AED" = maxPrice)
  // without building a rule-DSL nobody asked for.
  rules             Json?
  isActive          Boolean             @default(true)
  displayOrder      Int                 @default(0)
  createdAt         DateTime            @default(now())
  shop              shop                @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "Collection_shopId_fkey")
  collectionproduct collectionproduct[]
  biolink           biolink[]

  @@unique([shopId, slug], map: "Collection_shopId_slug_key")
  @@index([shopId], map: "Collection_shopId_fkey")
}

// MANUAL-collection membership + manual display order. Not used for
// RULE_BASED collections at all (see the `collection.type` comment).
model collectionproduct {
  collectionId Int
  productId    Int
  sortOrder    Int        @default(0)
  collection   collection @relation(fields: [collectionId], references: [id], onDelete: Cascade, map: "CollectionProduct_collectionId_fkey")
  product      product    @relation(fields: [productId], references: [id], onDelete: Cascade, map: "CollectionProduct_productId_fkey")

  @@id([collectionId, productId])
  @@index([productId], map: "CollectionProduct_productId_fkey")
}

// Referral/affiliate marketing (Shopify-style): a merchant-managed roster of
// affiliates, each with one or more shareable codes, each code attributable
// to storefront orders that used it — see AffiliateService for the
// attribution/commission/status-sync logic. Three tables mirror the admin
// UI's three tabs (Affiliate / Affiliate Codes / Affiliate Orders) exactly.
model affiliate {
  id            Int             @id @default(autoincrement())
  shopId        Int
  name          String
  mobile        String
  // active | inactive | blocked
  status        String          @default("active")
  createdAt     DateTime        @default(now())
  shop          shop            @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "Affiliate_shopId_fkey")
  affiliatecode affiliatecode[]

  @@index([shopId], map: "Affiliate_shopId_fkey")
}

model affiliatecode {
  id              Int              @id @default(autoincrement())
  shopId          Int
  affiliateId     Int
  code            String
  // What the code applies to — free text (e.g. "All Products" or a specific
  // product/category name typed by the merchant), not a real product/category
  // relation. Deliberately simple per the task's own scoping.
  promotionFor    String           @default("All Products")
  // approved | pending | blocked
  status          String           @default("approved")
  // percentage | fixed
  commissionType  String
  commissionValue Decimal          @db.Decimal(10, 2)
  // Null start/end means "always valid" on that side.
  validFrom       DateTime?
  validUntil      DateTime?
  createdAt       DateTime         @default(now())
  shop            shop             @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "AffiliateCode_shopId_fkey")
  affiliate       affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade, map: "AffiliateCode_affiliateId_fkey")
  affiliateorder  affiliateorder[]

  @@unique([shopId, code], map: "AffiliateCode_shopId_code_key")
  @@index([affiliateId], map: "AffiliateCode_affiliateId_fkey")
}

model affiliateorder {
  id               Int           @id @default(autoincrement())
  shopId           Int
  orderId          Int           @unique(map: "AffiliateOrder_orderId_key")
  affiliateCodeId  Int
  commissionAmount Decimal       @db.Decimal(10, 2)
  // pending | approved | blocked — auto-synced from the order's own
  // status/paymentStatus (delivered or paid -> approved, cancelled ->
  // blocked), but only ever moved away from 'pending' — see
  // AffiliateService.syncOrderStatus. The merchant's manual approve/block
  // action (Affiliate Orders tab) is likewise only available while 'pending'.
  status           String        @default("pending")
  createdAt        DateTime      @default(now())
  shop             shop          @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "AffiliateOrder_shopId_fkey")
  order            order         @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "AffiliateOrder_orderId_fkey")
  affiliatecode    affiliatecode @relation(fields: [affiliateCodeId], references: [id], onDelete: Restrict, map: "AffiliateOrder_affiliateCodeId_fkey")

  @@index([shopId], map: "AffiliateOrder_shopId_fkey")
  @@index([affiliateCodeId], map: "AffiliateOrder_affiliateCodeId_fkey")
}

// Merchant-supplied (Shopify-style bring-your-own-keys) per-shop payment
// gateway configuration — one row per shop per provider. `provider` is one
// of the PaymentProviderRegistry names that has a credential form in the
// admin UI: 'nomod' | 'stripe' | 'paypal' | 'tabby' | 'tamara'. Cash on
// Delivery is NOT a row here — it has no credentials and already exists as
// shop.deliveryPaymentCashOnDelivery/pickupPaymentCashOnPickup; the Payment
// Gateways settings page just gives those two existing booleans a second,
// unified toggle rather than inventing a redundant third COD flag (see
// PaymentSettingsService).
//
// nomod/stripe are mutually exclusive (enforced in PaymentSettingsService,
// not just a DB constraint — the check needs a clear rejection message, not
// a generic constraint-violation error) — "card processing," pick one.
// paypal/tabby/tamara are independent of that choice and of each other.
//
// A shop with NO row for 'nomod'/'stripe' is treated as "stripe enabled"
// (backward compatible with every shop that predates this table, which
// already defaults to shop.paymentGateway = 'stripe' via the platform's own
// STRIPE_SECRET_KEY env var) — see PaymentSettingsService.isCardProcessorEnabled.
// A shop with no row for paypal/tabby/tamara is simply "not enabled" (these
// are new, opt-in payment methods with no pre-existing default-on behavior
// to preserve).
model shoppaymentprovider {
  id          Int      @id @default(autoincrement())
  shopId      Int
  provider    String
  enabled     Boolean  @default(false)
  // AES-256-GCM encrypted JSON string of credential fields — shape varies
  // per provider (see payments/provider-credentials.ts). Null until the
  // merchant has saved credentials for this provider at least once. Never
  // returned to the client in decrypted form — see
  // PaymentSettingsService.toMaskedResponse.
  credentials String?  @db.Text
  updatedAt   DateTime @default(now()) @updatedAt
  shop        shop     @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "ShopPaymentProvider_shopId_fkey")

  @@unique([shopId, provider], map: "ShopPaymentProvider_shopId_provider_key")
}

// Phone is the primary match key (not email) — UAE customers rarely use
// email consistently at checkout, phone is what's actually collected every
// time. Unique per shop, not globally: the same phone number is a different
// customer at two unrelated shops.
model customer {
  id                   Int                    @id @default(autoincrement())
  shopId               Int
  name                 String
  phone                String
  email                String?
  birthday             DateTime?
  // Saved delivery addresses as a plain JSON array rather than a full
  // CustomerAddress relation table — nothing today needs to query/join
  // across addresses independently of their owning customer (no "find every
  // customer in zone X" feature exists yet). Shape: [{id, label, address,
  // emirate, area, latitude, longitude}] — `id` is a short server-generated
  // string (see customer-account.service.ts) so a single entry can be
  // referenced for edit/delete without a real child table.
  addresses            Json?
  createdAt            DateTime               @default(now())
  // Nullable auth fields directly on customer, not a separate
  // CustomerAuth/StorefrontUser model — mirrors how `user.passwordHash`
  // already lives directly on `user` rather than a split identity/auth
  // table (no precedent in this schema for that split). Most customer rows
  // are still guest-checkout-only and never set these; storefront
  // registration is "claim this existing [shopId, phone] row" (set
  // passwordHash on it), not creating a second linked entity. null
  // passwordHash = guest, never registered.
  passwordHash         String?
  emailVerified        Boolean                @default(false)
  registeredAt         DateTime?
  // UAE PDPL data-export rate limit (max once per 24h) — see
  // CustomerAccountService.exportData. Null until the first export.
  lastDataExportAt     DateTime?
  // Progressive login-delay tracking, same shape and reasoning as
  // user.failedLoginAttempts/lastFailedLoginAt (see AuthService.login's own
  // comment) — not a hard lockout: resets to 0 on any successful login, and
  // a correct password always succeeds once the computed delay since
  // lastFailedLoginAt has elapsed.
  failedLoginAttempts  Int                    @default(0)
  lastFailedLoginAt    DateTime?
  shop                 shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "Customer_shopId_fkey")
  order                order[]
  discountredemption   discountredemption[]
  draftorder           draftorder[]
  customerrefreshtoken customerrefreshtoken[]
  customerauthtoken    customerauthtoken[]
  giftcard             giftcard[]

  @@unique([shopId, phone], map: "Customer_shopId_phone_key")
  @@index([shopId], map: "Customer_shopId_fkey")
}

// Customer-facing storefront auth session — a separate table from
// `refreshtoken` (staff), not a shared one with a nullable customerId
// alongside userId: customers and staff are different security domains, and
// mixing them would need an app-level XOR check in every security-critical
// token lookup, exactly the place a subtle bug would be worst. Same
// rotation/family/CAS semantics as `refreshtoken` — see
// CustomerAuthService.refresh, which mirrors AuthService.refresh.
model customerrefreshtoken {
  id         Int       @id @default(autoincrement())
  customerId Int
  familyId   String
  tokenHash  String    @unique(map: "CustomerRefreshToken_tokenHash_key")
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  customer   customer  @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "CustomerRefreshToken_customerId_fkey")

  @@index([customerId], map: "CustomerRefreshToken_customerId_fkey")
  @@index([familyId], map: "CustomerRefreshToken_familyId_idx")
}

// Password-reset tokens for customer accounts — parallel to `authtoken`
// (staff) for the same reason as customerrefreshtoken above. Single-use,
// same purpose-discriminated shape as authtoken (only 'password_reset'
// today) in case a second purpose (e.g. email verification) is added later.
model customerauthtoken {
  id         Int       @id @default(autoincrement())
  customerId Int
  purpose    String
  tokenHash  String    @unique(map: "CustomerAuthToken_tokenHash_key")
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   customer  @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "CustomerAuthToken_customerId_fkey")

  @@index([customerId, purpose], map: "CustomerAuthToken_customerId_purpose_idx")
}

// A shop's physical branch. Products/categories are NOT outlet-scoped (one
// shared catalog across branches) — only orders and stock levels are.
model outlet {
  id                    Int                     @id @default(autoincrement())
  shopId                Int
  name                  String
  nameAr                String?
  // Outlet-level contact details, distinct from Shop's — a branch's own
  // email/WhatsApp, not the shop-wide ones from Business Settings.
  email                 String?
  whatsapp              String?
  // Top-level enable/disable switch, independent of the hours-derived
  // open/closed status — an inactive outlet is disabled regardless of what
  // its schedule says. Not wired into computeIsOpen (out of scope for the
  // page-conversion pass that introduced this field).
  active                Boolean                 @default(true)
  emirate               String?
  area                  String?
  phone                 String?
  latitude              Float?
  longitude             Float?
  // Per-branch schedule, independent of and not falling back to any
  // shop-level setting. JSON map of day -> { open, close, closed }, same
  // shape as shop.businessHours. Absent (null) means no schedule has been
  // set yet — treated as always-open, not always-closed, so a freshly
  // created outlet doesn't show as broken.
  businessHours         Json?
  // Manual "force closed" switch — always wins over the computed schedule
  // when true (holiday, unplanned closure). Not a dated exception calendar.
  // Auto-expires at the next day rollover (in shop.timezone) — see
  // computeIsOpen's check-on-read logic — but this raw flag itself is only
  // ever changed by an explicit merchant write, never by a read.
  closedOverride        Boolean                 @default(false)
  // Server-stamped whenever closedOverride is set true; never client-writable.
  closedOverrideSetAt   DateTime?
  pickupEnabled         Boolean                 @default(false)
  deliveryEnabled       Boolean                 @default(false)
  // Required (and validated) whenever deliveryEnabled is true — see
  // OutletsService. Not enforced against anything yet (no checkout exists);
  // captured and displayed only.
  deliveryRadiusKm      Float?
  createdAt             DateTime                @default(now())
  shop                  shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "Outlet_shopId_fkey")
  order                 order[]
  user                  user[]
  outletstock           outletstock[]
  outletvariantstock    outletvariantstock[]
  outletingredientstock outletingredientstock[]
  deliveryzone          deliveryzone[]
  draftorder            draftorder[]
  stockmovementFrom     stockmovement[]         @relation("StockMovementOutlet")
  stockmovementTo       stockmovement[]         @relation("StockMovementToOutlet")
  abandonedcart         abandonedcart[]
  scansettings          scansettings[]
  useroutletrole        useroutletrole[]

  @@index([shopId], map: "Outlet_shopId_fkey")
}

// Named delivery zone (e.g. "Dubai", "DXB/SHJ/AJM") with its own flat fee and
// minimum order amount — additive to, not replacing, the radius-based
// deliveryRadiusKm on the outlet itself. Real CRUD table, not a JSON blob,
// since zones need independent create/edit/delete.
model deliveryzone {
  id             Int      @id @default(autoincrement())
  outletId       Int
  name           String
  fee            Decimal
  minOrderAmount Decimal  @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  outlet         outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade, map: "DeliveryZone_outletId_fkey")

  @@index([outletId], map: "DeliveryZone_outletId_fkey")
}

// Per-outlet stock count for a shop-wide product. Replaces the old
// Product.stockQuantity/lowStockThreshold columns — the catalog stays
// shared, but how many units sit at each branch (and each branch's reorder
// threshold) genuinely differs, so it lives on the join, not the product.
model outletstock {
  outletId          Int
  productId         Int
  stockQuantity     Int     @default(0)
  // See outletvariantstock.lowStockThreshold's comment — nullable/off by
  // default, per-outlet.
  lowStockThreshold Int?
  outlet            outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade, map: "OutletStock_outletId_fkey")
  product           product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "OutletStock_productId_fkey")

  @@id([outletId, productId])
  @@index([productId], map: "OutletStock_productId_fkey")
}

// Raw material/component a merchant tracks stock of but never sells —
// deliberately a separate model from `product`, not a `product.isIngredient`
// flag: the field sets genuinely differ (no price/sku-for-sale/variants/SEO/
// publishing here), and keeping it separate means an ingredient can never
// leak onto the storefront through a Product query somewhere that wasn't
// updated to filter it out — there's structurally no code path from
// src/public to this table at all (see IngredientsModule; not imported by
// PublicModule, no route under /public references it).
model ingredient {
  id                    Int                     @id @default(autoincrement())
  shopId                Int
  name                  String
  // Free text (e.g. "stems", "grams", "pieces") rather than a fixed enum —
  // same reasoning as product.productType/vendor: merchant-defined, not a
  // closed set the backend needs to branch on.
  unit                  String
  // Kept for consistency with product.trackInventory's shape even though
  // there's no real use case for an untracked ingredient today (the whole
  // point of this model is stock tracking) — IngredientsService can still
  // gate stock-mutation code paths on it exactly like ProductsService does,
  // rather than that logic assuming "ingredient" always implies "tracked".
  trackInventory        Boolean                 @default(true)
  // Single image, not a productimage-style gallery — ingredients have no
  // multi-photo/reorder use case anywhere in this app (no storefront
  // exposure, no variant-level image override to sync). Same "one field is
  // enough" reasoning category.image already uses.
  image                 String?
  description           String?                 @db.Text
  // Decimal like product.costPrice, not Int like ingredient stock — cost
  // per unit is money, needs real fractional precision (e.g. 0.75 AED per
  // gram), unlike stockQuantity/quantityPerUnit which are deliberately
  // whole numbers (see productingredient's comment on quantityPerUnit).
  costPerUnit           Decimal?
  // Free text, not a `supplier` entity/relation — no purchase-order or
  // multi-supplier-per-ingredient use case exists anywhere in this app to
  // justify a real table; a name/contact string is what merchants asked for.
  supplier              String?
  categoryId            Int?
  createdAt             DateTime                @default(now())
  shop                  shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "Ingredient_shopId_fkey")
  category              ingredientcategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "Ingredient_categoryId_fkey")
  outletingredientstock outletingredientstock[]
  stockmovement         stockmovement[]
  productingredient     productingredient[]

  @@index([shopId], map: "Ingredient_shopId_fkey")
  @@index([categoryId], map: "Ingredient_categoryId_fkey")
}

// Flat (no parent/tree) unlike `category` — ingredient categories are a
// purely internal inventory-organization concept with no storefront
// navigation use case (ingredients themselves are structurally unreachable
// from /public, see `ingredient`'s own comment), so the unlimited-depth
// tree/cycle-guard machinery `category` needs for storefront nav menus
// would be pure overhead here.
model ingredientcategory {
  id         Int          @id @default(autoincrement())
  shopId     Int
  name       String
  createdAt  DateTime     @default(now())
  shop       shop         @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "IngredientCategory_shopId_fkey")
  ingredient ingredient[]

  @@index([shopId], map: "IngredientCategory_shopId_fkey")
}

// A named, admin-defined bundle of permissions (see common/permissions.ts
// for the fixed vocabulary) that can be assigned to a staff member at a
// specific outlet via useroutletrole — layered on top of, not replacing,
// the shop-wide 4-tier user.role. `permissions` is a JSON array of keys
// from that fixed enum rather than a join table: the vocabulary is small
// and fixed, nothing needs to query "which bundles include permission X",
// and the app layer validates each string against the enum on write.
model branchrole {
  id             Int              @id @default(autoincrement())
  shopId         Int
  name           String
  permissions    Json
  createdAt      DateTime         @default(now())
  shop           shop             @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "BranchRole_shopId_fkey")
  useroutletrole useroutletrole[]

  @@unique([shopId, name], map: "BranchRole_shopId_name_key")
  @@index([shopId], map: "BranchRole_shopId_fkey")
}

// One row per (user, outlet): "at this outlet, this user's effective
// permissions come from this branchrole instead of their shop-wide role."
// Absence of a row for a given (user, outlet) pair means no override —
// resolveEffectivePermissions falls through to today's ctx.role-based
// logic entirely unchanged. The actual restrict-only security guarantee
// (an override can never grant MORE than the user's shop-wide role
// already permits) is enforced at read time by intersecting this
// branchrole's permissions with basePermissionsFor(user.role) — not by
// anything in this table's shape, which is deliberately just a plain
// pointer. See common/permissions.ts.
model useroutletrole {
  id           Int        @id @default(autoincrement())
  userId       Int
  outletId     Int
  branchRoleId Int
  createdAt    DateTime   @default(now())
  user         user       @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserOutletRole_userId_fkey")
  outlet       outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade, map: "UserOutletRole_outletId_fkey")
  branchrole   branchrole @relation(fields: [branchRoleId], references: [id], onDelete: Cascade, map: "UserOutletRole_branchRoleId_fkey")

  @@unique([userId, outletId], map: "UserOutletRole_userId_outletId_key")
  @@index([outletId], map: "UserOutletRole_outletId_fkey")
  @@index([branchRoleId], map: "UserOutletRole_branchRoleId_fkey")
}

// Per-outlet stock count for an ingredient — parallel to outletstock
// (product-level), not an overload of it, same reasoning as
// outletvariantstock existing alongside outletstock instead of reusing it.
model outletingredientstock {
  outletId          Int
  ingredientId      Int
  stockQuantity     Int        @default(0)
  // See outletvariantstock.lowStockThreshold's comment — nullable/off by
  // default, per-outlet.
  lowStockThreshold Int?
  outlet            outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade, map: "OutletIngredientStock_outletId_fkey")
  ingredient        ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade, map: "OutletIngredientStock_ingredientId_fkey")

  @@id([outletId, ingredientId])
  @@index([ingredientId], map: "OutletIngredientStock_ingredientId_fkey")
}

// Bill of Materials: links a Product (optionally scoped to one specific
// variant) to the Ingredient(s) consumed to make one unit of it, and how
// many. variantId is a nullable discriminator on this row — the same
// "nullable FK picks which shape a row is" convention stockmovement's own
// nullable productId/variantId/ingredientId/toOutletId columns already use
// (see its comment below), applied here to toggle between two row *shapes*
// for one productId+ingredientId pair rather than an XOR of unrelated
// entities: productId and ingredientId are always BOTH set (a recipe row is
// meaningless without either) — only variantId toggles between "product-level
// default" (null; applies to the product itself if it has no variants, and
// to any variant that doesn't have a more specific row of its own) and
// "override for this one variant" (set).
// quantityPerUnit is a whole number, matching outletingredientstock's own
// Int stock quantity — see ProductsService.consumeForOrderItems's comment
// for why fractional-unit recipes (e.g. 0.5 kg) are out of scope: supporting
// them would mean widening ingredient stock itself from Int to Decimal
// everywhere it's touched (CSV import, Scan to Stock, adjustments,
// transfers, the low-stock digest), a far bigger blast radius than this
// feature asks for. A merchant needing finer granularity should track the
// ingredient in a smaller unit (e.g. grams instead of kg) instead.
model productingredient {
  id              Int             @id @default(autoincrement())
  shopId          Int
  productId       Int
  variantId       Int?
  ingredientId    Int
  quantityPerUnit Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  shop            shop            @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "ProductIngredient_shopId_fkey")
  product         product         @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductIngredient_productId_fkey")
  variant         productvariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "ProductIngredient_variantId_fkey")
  ingredient      ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Cascade, map: "ProductIngredient_ingredientId_fkey")

  // Only stops a duplicate at the DB level for the variant-specific case
  // (variantId NOT NULL) — MySQL treats every NULL as distinct, so this
  // can't also catch two product-level-default rows for the same
  // ingredient. That case is rejected at the service level instead (see
  // ProductsService.replaceProductIngredients), same "app-enforced, not a
  // DB constraint" convention already used for stockmovement's own
  // productId/ingredientId exclusivity below. In practice this table is
  // always fully replaced per product/variant (delete-all-then-recreate,
  // same convention as product images/categories/tags), never incrementally
  // upserted, so there's no concurrent-insert race for this index to guard
  // against in the first place.
  @@unique([productId, variantId, ingredientId], map: "ProductIngredient_product_variant_ingredient_key")
  @@index([shopId], map: "ProductIngredient_shopId_fkey")
  @@index([variantId], map: "ProductIngredient_variantId_fkey")
  @@index([ingredientId], map: "ProductIngredient_ingredientId_fkey")
}

// One shared chronological log for BOTH inventory transfers and
// reason-coded adjustments, rather than two separate tables — a merchant
// wants one movement history per product ("what happened to this stock and
// why"), not two logs to cross-reference by hand; this mirrors how
// Shopify's own Inventory History view mixes adjustments and transfers in
// a single timeline. `type` distinguishes the two shapes sharing this row:
//   - ADJUSTMENT: `reason` set (received/damaged/recount/other), `delta` is
//     signed (+/-), `outletId` is the outlet affected, `toOutletId` null.
//   - TRANSFER: `reason` null, `delta` is always positive (units moved),
//     `outletId` is the source outlet, `toOutletId` the destination.
//   - CONSUMED: Bill of Materials auto-deduction — `reason` null, `delta` is
//     signed (negative consuming stock at order creation/confirmation,
//     positive restocking on cancel), `outletId` is the fulfilling outlet,
//     `toOutletId` null. Always `ingredientId` set, `productId`/`variantId`
//     null — see ProductsService.consumeForOrderItems.
// This table is an audit trail, not a source of truth for current stock —
// outletstock/outletvariantstock remain that; this only ever gets inserted
// into, alongside (same transaction as) the real stock mutation.
// productId/ingredientId: exactly one set, never both/neither — enforced in
// ProductsService/IngredientsService (whichever creates the row), same
// app-level-not-DB-constraint convention as every other discriminated-field
// model in this schema (see biolink's type/url/productId/categoryId comment
// above). Both nullable rather than a separate ingredientstockmovement
// table — a merchant wants one Movement History timeline mixing products
// and ingredients (same reasoning the original ADJUSTMENT/TRANSFER comment
// below gives for sharing one table instead of two).
model stockmovement {
  id           Int             @id @default(autoincrement())
  shopId       Int
  productId    Int?
  variantId    Int?
  ingredientId Int?
  type         String
  reason       String?
  delta        Int
  outletId     Int
  toOutletId   Int?
  note         String?         @db.Text
  // Nullable: every pre-existing movement type is staff-initiated (an admin
  // adjusts/transfers/imports/scans), always with a real ctx.userId. Bill of
  // Materials adds the first genuinely system-triggered type (CONSUMED, from
  // a storefront checkout with no authenticated staff user at all) — see
  // ProductsService.consumeForOrderItems. Left set to the acting admin's id
  // for CONSUMED rows produced by an admin-side trigger (confirming/
  // cancelling an order, or an admin-entered immediate-reservation order),
  // same as every other type; null only for the genuinely anonymous
  // storefront-checkout case.
  actorUserId  Int?
  createdAt    DateTime        @default(now())
  // Set only for type: RECEIVED (Scan to Stock) — groups every movement
  // produced by one confirmed scan commit under the source image, for the
  // audit trail. Null for every other movement type.
  scanBatchId  Int?
  shop         shop            @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "StockMovement_shopId_fkey")
  product      product?        @relation(fields: [productId], references: [id], onDelete: Cascade, map: "StockMovement_productId_fkey")
  variant      productvariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, map: "StockMovement_variantId_fkey")
  ingredient   ingredient?     @relation(fields: [ingredientId], references: [id], onDelete: Cascade, map: "StockMovement_ingredientId_fkey")
  outlet       outlet          @relation("StockMovementOutlet", fields: [outletId], references: [id], onDelete: Cascade, map: "StockMovement_outletId_fkey")
  toOutlet     outlet?         @relation("StockMovementToOutlet", fields: [toOutletId], references: [id], onDelete: Cascade, map: "StockMovement_toOutletId_fkey")
  actor        user?           @relation(fields: [actorUserId], references: [id], map: "StockMovement_actorUserId_fkey")
  scanbatch    scanbatch?      @relation(fields: [scanBatchId], references: [id], onDelete: SetNull, map: "StockMovement_scanBatchId_fkey")

  @@index([shopId, productId], map: "StockMovement_shopId_productId_idx")
  @@index([shopId, createdAt], map: "StockMovement_shopId_createdAt_idx")
  @@index([variantId], map: "StockMovement_variantId_fkey")
  @@index([ingredientId], map: "StockMovement_ingredientId_fkey")
  @@index([outletId], map: "StockMovement_outletId_fkey")
  @@index([toOutletId], map: "StockMovement_toOutletId_fkey")
  @@index([actorUserId], map: "StockMovement_actorUserId_fkey")
  @@index([scanBatchId], map: "StockMovement_scanBatchId_fkey")
}

// One row per confirmed "Scan to Stock" commit — exists purely as the audit
// anchor for the source photo (imageUrl) that a batch of RECEIVED
// stockmovement rows came from; the movements themselves are still the
// source of truth for stock changes, same as every other movement type.
model scanbatch {
  id            Int             @id @default(autoincrement())
  shopId        Int
  imageUrl      String
  actorUserId   Int
  createdAt     DateTime        @default(now())
  shop          shop            @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "ScanBatch_shopId_fkey")
  actor         user            @relation(fields: [actorUserId], references: [id], map: "ScanBatch_actorUserId_fkey")
  stockmovement stockmovement[]

  @@index([shopId], map: "ScanBatch_shopId_idx")
  @@index([actorUserId], map: "ScanBatch_actorUserId_fkey")
}

// Per-shop config for "Scan to Stock" OCR parsing — one row per shop,
// upserted (findUnique-or-defaults / upsert), same convention as
// shopseosettings/themesettings rather than columns on shop itself, since
// this is a self-contained feature's settings, not general shop config.
// excludeKeywords/includeKeywords are Json string arrays (merchant-edited
// chip lists, no relational structure needed) rather than a child table —
// matches shop.socialLinks/businessHours's Json-blob-for-a-simple-list
// convention elsewhere in this schema.
model scansettings {
  id                Int      @id @default(autoincrement())
  shopId            Int      @unique(map: "ScanSettings_shopId_key")
  excludeKeywords   Json
  includeKeywords   Json
  defaultOutletId   Int?
  // 'ask' | 'create' — whether an OCR line with no confident match defaults
  // to "flag for the merchant to decide" (ask) or "assume it's a new
  // product/ingredient" (create) when the review screen first renders it.
  // Either way the merchant can still override per-row before confirming.
  unmatchedBehavior String   @default("ask")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  shop              shop     @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "ScanSettings_shopId_fkey")
  defaultOutlet     outlet?  @relation(fields: [defaultOutletId], references: [id], onDelete: SetNull, map: "ScanSettings_defaultOutletId_fkey")

  @@index([defaultOutletId], map: "ScanSettings_defaultOutletId_fkey")
}

// One row per shop (business-level, not per-outlet) — the storefront's
// live branding. `brandColor` is the primary/accent color (existing field,
// kept as-is rather than renamed, since PublicService.getShop already reads
// it and there's no reason to churn a working read path); `secondaryColor`
// is new — see storefront ShopProvider for how the two map onto
// --color-accent/--color-accent-hover. `faviconUrl` and `fontFamily` are
// new; `templateId` remains an unused placeholder (no template system
// exists — out of scope here, same as when it was first added).
model themesettings {
  id                       Int      @id @default(autoincrement())
  shopId                   Int      @unique(map: "ThemeSettings_shopId_key")
  templateId               Int?
  logoUrl                  String?
  bannerUrl                String?
  brandColor               String?
  secondaryColor           String?
  heroText                 String?
  faviconUrl               String?
  // One of FONT_CHOICES (see theme/constants.ts) — curated list, not
  // arbitrary font upload, per the task brief.
  fontFamily               String?
  // Now rendered in the storefront footer's brand column (see
  // storefront/components/Footer.tsx) — was saved-but-unrendered before the
  // footer existed.
  footerLogoUrl            String?
  // Merchant-written blurb for the footer's brand column — distinct from
  // shop.description (SEO/meta + Site Title card), which is a business
  // description, not necessarily footer-appropriate copy. Short by
  // convention (enforced client-side only, same as heroText).
  footerDescription        String?  @db.Text
  // Announcement-bar messages, e.g. ["Free delivery over 100 AED"] — plain
  // string array (the reference's tag-style input), rendered as a slim bar
  // above the storefront header (see ShopLayoutClient.tsx).
  notificationText         Json?
  // Off by default — an empty notificationText array already suppresses the
  // bar, but this lets a merchant temporarily hide it without clearing
  // saved text (same "toggle vs. clear the data" reasoning as every other
  // notify*/enabled flag in this schema, e.g. shop.notifyEmail).
  announcementBarEnabled   Boolean  @default(false)
  // Static (joined with " • ") vs. a continuously scrolling marquee — pure
  // CSS animation on the storefront (see components/AnnouncementBar.tsx),
  // not JS-driven, so this flag only switches which CSS class renders.
  announcementBarScrolling Boolean  @default(false)
  // Storefront-facing contact number(s) — distinct from shop.whatsappNumber
  // (a different, WhatsApp-specific concept). String array so "show
  // multiple numbers" is just "the array has more than one entry" rather
  // than a separate boolean that could drift out of sync with it.
  contactNumbers           Json?
  // Record<key, hex> for the ~22 granular Appearance Color fields — see
  // theme/constants.ts's THEME_COLOR_FIELDS for the full key list, defaults,
  // and which ones actually have a storefront element to apply to.
  colors                   Json?
  // Advanced tab — one of HOMEPAGE_LAYOUTS (theme/constants.ts): a fixed,
  // Requital-maintained set of homepage layouts, not merchant-composable
  // sections (that's the deferred full drag-and-drop builder — 'custom' is
  // reserved in the enum for it, unused today). Non-nullable with a
  // default: every shop always has SOME layout, "classic" being today's
  // existing (only) behavior, so this ships as a no-op for every shop that
  // never touches the Advanced tab.
  homepageLayout           String   @default("classic")
  // Theme Customizer v2 — curated per-page-type layout presets and global
  // chrome/icon/button styling, all following the exact same "VARCHAR enum
  // string, NOT NULL DEFAULT <current behavior>" shape as homepageLayout
  // above, so every existing shop's storefront renders byte-for-byte
  // unchanged until a merchant actively opens Theme and picks something
  // else. See theme/constants.ts for the selectable value lists and
  // storefront lib/{layout,icon-style,button-style}.ts for what each one
  // actually switches. Not new tables/JSON — each is a single closed enum,
  // same reasoning as homepageLayout: no query/filter need of its own.
  topBarLayout             String   @default("logo_left")
  iconStyle                String   @default("outline")
  buttonRadius             String   @default("rounded")
  buttonFill               String   @default("solid")
  pdpLayout                String   @default("gallery_left")
  cartLayout               String   @default("full_page")
  checkoutLayout           String   @default("single_page")
  // Footer's structural arrangement — 'columns' (brand/links/social+contact
  // side by side, the original/only shape) vs 'centered' (a simpler single
  // stacked column, common minimal-footer alternative). Same "fixed enum,
  // Requital-maintained set" shape as topBarLayout above.
  footerLayout             String   @default("columns")
  // Height/padding only — independent of topBarLayout/footerLayout's
  // structural arrangement, so a merchant can pair any arrangement with any
  // density. 'regular' matches this feature's original (only) padding.
  headerDensity            String   @default("regular")
  footerDensity            String   @default("regular")
  // For the Theme library page's "last saved" timestamp — nothing else in
  // this table needed it before (see shop.updatedAt's identical addition,
  // added the same way for the same reason, in an earlier task).
  updatedAt                DateTime @default(now()) @updatedAt
  shop                     shop     @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "ThemeSettings_shopId_fkey")
}

// Deliberately its own table rather than more columns on themesettings —
// SEO is a distinct settings concern from branding (separate admin tab),
// and ogImage has its own fallback chain (falls back to Theme's banner/logo,
// not the other way around) that's easier to reason about as a sibling
// table than interleaved fields on the same row.
model shopseosettings {
  id              Int     @id @default(autoincrement())
  shopId          Int     @unique(map: "ShopSeoSettings_shopId_key")
  metaTitle       String?
  metaDescription String? @db.Text
  ogImage         String?
  // Low modern SEO value, kept only for parity with the reference platform.
  keywords        String? @db.Text
  shop            shop    @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "ShopSeoSettings_shopId_fkey")
}

// role: "admin" (full shop access, outletId always null) or "branch"
// (scoped to exactly one outlet — outletId always set). Enforced in
// application code, not a DB constraint — see auth/roles.guard.ts.
model user {
  id             Int              @id @default(autoincrement())
  shopId         Int
  outletId       Int?
  email          String           @unique(map: "User_email_key")
  name           String
  passwordHash   String
  // Personal contact number collected on the Account Setup wizard's
  // Personal Info step — distinct from shop.whatsappNumber (the shop's own
  // WhatsApp Business number, set later in Settings).
  phone          String?
  role           String           @default("admin")
  emailVerified  Boolean          @default(false)
  // Progressive login-delay tracking (see AuthService.login's own comment) —
  // not a hard lockout: failedLoginAttempts resets to 0 on any successful
  // login, and a correct password always succeeds once the computed delay
  // since lastFailedLoginAt has elapsed. Deliberately not a `lockedUntil`
  // column that could deny a real user access outright.
  failedLoginAttempts Int          @default(0)
  lastFailedLoginAt   DateTime?
  createdAt      DateTime         @default(now())
  shop           shop             @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "User_shopId_fkey")
  outlet         outlet?          @relation(fields: [outletId], references: [id], onDelete: SetNull, map: "User_outletId_fkey")
  refreshtoken   refreshtoken[]
  authtoken      authtoken[]
  stockmovement  stockmovement[]
  ordernote      ordernote[]
  auditlog       auditlog[]
  orderreturn    orderreturn[]
  scanbatch      scanbatch[]
  useroutletrole useroutletrole[]

  @@index([shopId], map: "User_shopId_fkey")
  @@index([outletId], map: "User_outletId_fkey")
}

// One row per issued refresh token, hashed at rest (raw token only ever
// exists client-side and in the HTTP response that issued it). `familyId`
// ties every token in one login's rotation chain together — set once at
// login/signup and carried forward unchanged on every rotation — so reuse
// of an already-rotated (revokedAt set) token can revoke the whole chain in
// one query instead of walking a linked list of "replaced by" pointers.
model refreshtoken {
  id        Int       @id @default(autoincrement())
  userId    Int
  familyId  String
  tokenHash String    @unique(map: "RefreshToken_tokenHash_key")
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "RefreshToken_userId_fkey")

  @@index([userId], map: "RefreshToken_userId_fkey")
  @@index([familyId], map: "RefreshToken_familyId_idx")
}

// Single-use, time-limited tokens for password reset and email verification
// — one table with a `purpose` discriminator rather than two near-identical
// ones, since both are "prove control of this account's email, once, within
// a short window" with the same shape. Hashed at rest, same as refreshtoken.
model authtoken {
  id        Int       @id @default(autoincrement())
  userId    Int
  purpose   String // 'password_reset' | 'email_verification'
  tokenHash String    @unique(map: "AuthToken_tokenHash_key")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "AuthToken_userId_fkey")

  @@index([userId, purpose], map: "AuthToken_userId_purpose_idx")
}

// Promo/discount codes. `code` is stored normalized to uppercase (see
// DiscountsService) — this DB's default collation (utf8mb4_unicode_ci) is
// already case-insensitive for comparisons/unique constraints, but
// normalizing on write too keeps app-level logic (and the code shown back to
// merchants) unambiguous rather than depending on collation behavior alone.
// type/appliesTo are plain strings, not Prisma enums — matches every other
// discriminated field in this schema (order.status, biolink.type, etc).
// value is null only for FREE_SHIPPING, which has no numeric amount.
model discount {
  id                    Int                  @id @default(autoincrement())
  shopId                Int
  code                  String
  type                  String
  value                 Decimal?
  minPurchaseAmount     Decimal?
  appliesTo             String               @default("ALL_PRODUCTS")
  usageLimit            Int?
  usageLimitPerCustomer Int?
  startsAt              DateTime?
  endsAt                DateTime?
  active                Boolean              @default(true)
  // Atomically incremented — see DiscountsService.redeem, same CAS
  // WHERE-guarded updateMany idiom as OrdersService's stock decrement.
  timesUsed             Int                  @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @default(now()) @updatedAt
  shop                  shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "Discount_shopId_fkey")
  discountproduct       discountproduct[]
  discountcategory      discountcategory[]
  discountredemption    discountredemption[]
  order                 order[]
  draftorder            draftorder[]

  @@unique([shopId, code], map: "Discount_shopId_code_key")
  @@index([shopId], map: "Discount_shopId_fkey")
}

model discountproduct {
  discountId Int
  productId  Int
  discount   discount @relation(fields: [discountId], references: [id], onDelete: Cascade, map: "DiscountProduct_discountId_fkey")
  product    product  @relation(fields: [productId], references: [id], onDelete: Cascade, map: "DiscountProduct_productId_fkey")

  @@id([discountId, productId])
  @@index([productId], map: "DiscountProduct_productId_fkey")
}

model discountcategory {
  discountId Int
  categoryId Int
  discount   discount @relation(fields: [discountId], references: [id], onDelete: Cascade, map: "DiscountCategory_discountId_fkey")
  category   category @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "DiscountCategory_categoryId_fkey")

  @@id([discountId, categoryId])
  @@index([categoryId], map: "DiscountCategory_categoryId_fkey")
}

// One row per successful redemption — an audit trail, and specifically what
// makes usageLimitPerCustomer enforceable (count rows for a given
// discountId+customerId) without a denormalized per-customer counter column.
// customerId nullable: a storefront guest order might not resolve to a
// customer until after redemption is claimed inside the same transaction
// (see PublicService.createOrder) — orderId is the durable link either way.
model discountredemption {
  id         Int       @id @default(autoincrement())
  discountId Int
  customerId Int?
  orderId    Int       @unique(map: "DiscountRedemption_orderId_key")
  createdAt  DateTime  @default(now())
  discount   discount  @relation(fields: [discountId], references: [id], onDelete: Cascade, map: "DiscountRedemption_discountId_fkey")
  customer   customer? @relation(fields: [customerId], references: [id], onDelete: SetNull, map: "DiscountRedemption_customerId_fkey")
  order      order     @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "DiscountRedemption_orderId_fkey")

  @@index([discountId, customerId], map: "DiscountRedemption_discountId_customerId_idx")
  @@index([customerId], map: "DiscountRedemption_customerId_fkey")
}

// Admin-built order on behalf of a customer (phone/WhatsApp orders) — not a
// real Order until completed (see DraftOrdersService.complete/sendInvoice,
// which both funnel into OrdersService.create — the exact same
// pricing/item-resolution/customer path a storefront or admin-entered order
// uses, so the two systems can't silently drift apart). customerName/Phone/
// Address are captured inline (same free-text shape as Order itself) since a
// draft's customer is very often new/unregistered until conversion.
model draftorder {
  id               Int              @id @default(autoincrement())
  shopId           Int
  outletId         Int
  status           String           @default("OPEN")
  customerId       Int?
  customerName     String
  customerPhone    String
  customerEmail    String?
  customerAddress  String?          @db.Text
  emirate          String?
  area             String?
  orderType        String?
  discountId       Int?
  notes            String?          @db.Text
  // Set once either complete() or sendInvoice() converts this into a real
  // Order — see DraftOrdersService. A draft can only ever convert once
  // (both endpoints check this first and no-op/reject otherwise).
  convertedOrderId Int?             @unique(map: "DraftOrder_convertedOrderId_key")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  shop             shop             @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "DraftOrder_shopId_fkey")
  outlet           outlet           @relation(fields: [outletId], references: [id], onDelete: Restrict, map: "DraftOrder_outletId_fkey")
  customer         customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull, map: "DraftOrder_customerId_fkey")
  discount         discount?        @relation(fields: [discountId], references: [id], onDelete: SetNull, map: "DraftOrder_discountId_fkey")
  convertedOrder   order?           @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull, map: "DraftOrder_convertedOrderId_fkey")
  draftorderitem   draftorderitem[]

  @@index([shopId], map: "DraftOrder_shopId_fkey")
  @@index([outletId], map: "DraftOrder_outletId_fkey")
  @@index([customerId], map: "DraftOrder_customerId_fkey")
  @@index([discountId], map: "DraftOrder_discountId_fkey")
}

// price is independently editable per line (phone orders sometimes need a
// manual adjustment) — defaults to the product/variant's current price when
// added, but isn't kept in sync afterward, same "snapshot, not a live
// reference" principle as orderitem.priceAtPurchase.
model draftorderitem {
  id           Int             @id @default(autoincrement())
  draftOrderId Int
  productId    Int
  variantId    Int?
  productName  String
  quantity     Int
  price        Decimal
  draftorder   draftorder      @relation(fields: [draftOrderId], references: [id], onDelete: Cascade, map: "DraftOrderItem_draftOrderId_fkey")
  product      product         @relation(fields: [productId], references: [id], onDelete: Restrict, map: "DraftOrderItem_productId_fkey")
  variant      productvariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, map: "DraftOrderItem_variantId_fkey")

  @@index([draftOrderId], map: "DraftOrderItem_draftOrderId_fkey")
  @@index([productId], map: "DraftOrderItem_productId_fkey")
  @@index([variantId], map: "DraftOrderItem_variantId_fkey")
}

// Abandoned Cart Recovery — one row per (shop, phone) "in-progress checkout"
// episode. There is no earlier server-side checkout/reservation state in
// this codebase to hook into (stock is reserved atomically inside
// PublicService.createOrder itself, at final submit — see its own comment
// on that), so this is a genuinely new lightweight intermediate state,
// created by the storefront the moment a shopper has entered enough contact
// info to be reachable (name + phone), not on every keystroke — see
// PublicController's abandoned-cart capture endpoint.
//
// Unique on [shopId, customerPhone] rather than one row per attempt: the
// capture endpoint upserts this row every time contact info is (re)entered
// during checkout, refreshing the cart snapshot without spawning duplicate
// "episodes" for the same still-open cart. A genuinely NEW abandonment
// episode (after a prior one already recovered) resets the row rather than
// creating a second one — see AbandonedCartsService.capture.
model abandonedcart {
  id                  Int       @id @default(autoincrement())
  shopId              Int
  outletId            Int?
  customerName        String
  customerPhone       String
  customerEmail       String?
  // Snapshot at capture time: [{productId, variantId, name, variantLabel,
  // price, quantity, thumbnail}] — enough to render the recovery email and
  // the admin list without joining back through orderitem (there is no
  // order yet). Refreshed on every capture upsert while the episode is
  // still open.
  cartItems           Json
  cartValue           Decimal
  // Kept stable across capture-upsert refreshes within the same open
  // episode (only reset when a fresh episode starts) — this is "when did
  // the customer first show up," what the recovery window is measured from
  // and what the admin list's "time abandoned" column shows.
  capturedAt          DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  // Opaque bearer token for the public, unauthenticated cart-recovery link
  // in the email — same plaintext-token-as-credential shape as
  // order.trackingToken, not the row's own numeric id (which would let the
  // link be guessed/enumerated).
  recoverToken        String    @unique(map: "AbandonedCart_recoverToken_key")
  // Set exactly once, via a CAS updateMany (WHERE recoveryEmailSentAt IS
  // NULL) — see AbandonedCartsService.sendDueRecoveryEmails — so this can
  // never double-send even if the scheduled job overlaps itself or reruns.
  recoveryEmailSentAt DateTime?
  // Set by PublicService.createOrder via a CAS updateMany (WHERE
  // recoveredOrderId IS NULL) the moment a matching (shopId, phone) order
  // completes — this is also what the recovery job's own claim query
  // excludes on, so an order completing in the same window as a pending
  // recovery send can never result in a recovery email for a since-
  // completed cart (whichever write lands first wins the row).
  recoveredOrderId    Int?      @unique(map: "AbandonedCart_recoveredOrderId_key")
  shop                shop      @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "AbandonedCart_shopId_fkey")
  outlet              outlet?   @relation(fields: [outletId], references: [id], onDelete: SetNull, map: "AbandonedCart_outletId_fkey")
  recoveredOrder      order?    @relation(fields: [recoveredOrderId], references: [id], onDelete: SetNull, map: "AbandonedCart_recoveredOrderId_fkey")

  @@unique([shopId, customerPhone], map: "AbandonedCart_shopId_customerPhone_key")
  @@index([shopId], map: "AbandonedCart_shopId_fkey")
  @@index([outletId], map: "AbandonedCart_outletId_fkey")
}

// Digital gift cards — sold as a special product (product.isGiftCard, see
// its own comment) or issued directly by a merchant (admin CRUD, no
// purchaseOrderId) as service credit/promotions. code is the actual
// redemption credential (opaque, generated, globally unique — looked up
// with no shop context needed at redemption time, same shape as
// order.trackingToken) — remainingBalance is drawn down by
// giftcardredemption rows and topped back up by ReturnsService crediting a
// partial/full refund back to the card instead of the payment provider.
model giftcard {
  id                    Int                  @id @default(autoincrement())
  shopId                Int
  code                  String               @unique(map: "GiftCard_code_key")
  initialValue          Decimal
  remainingBalance      Decimal
  // active | redeemed (balance hit 0 through spending) | expired | disabled
  // (merchant-revoked, e.g. fraud) — see GiftCardsService.syncStatus for how
  // active/redeemed transition automatically off remainingBalance; expired/
  // disabled are only ever set explicitly (by expiry check / admin action)
  // and are never auto-overwritten back to active by a refund credit.
  status                String               @default("active")
  expiresAt             DateTime?
  // Which customer this card belongs to, if any — set from the purchasing
  // customer for a storefront purchase; left null for an admin-issued card
  // with no specific customer on file yet (the code itself is still fully
  // redeemable by whoever has it, same bearer-credential model as a
  // physical gift card).
  purchasedByCustomerId Int?
  // The order that purchased this card, if sold as a product — null for an
  // admin-issued card. Named relation since order also has an unrelated,
  // opposite-direction relation to giftcard (giftCardId — the card a *given*
  // order was PAID with) — see that field's own comment.
  purchaseOrderId       Int?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @default(now()) @updatedAt
  shop                  shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade, map: "GiftCard_shopId_fkey")
  purchasedByCustomer   customer?            @relation(fields: [purchasedByCustomerId], references: [id], onDelete: SetNull, map: "GiftCard_purchasedByCustomerId_fkey")
  purchaseOrder         order?               @relation("GiftCardPurchaseOrder", fields: [purchaseOrderId], references: [id], onDelete: SetNull, map: "GiftCard_purchaseOrderId_fkey")
  paidOrders            order[]              @relation("OrderGiftCardPayment")
  giftcardredemption    giftcardredemption[]

  @@index([shopId], map: "GiftCard_shopId_fkey")
  @@index([purchasedByCustomerId], map: "GiftCard_purchasedByCustomerId_fkey")
  @@index([purchaseOrderId], map: "GiftCard_purchaseOrderId_fkey")
}

// One row per order that spent (part of) a gift card's balance — audit
// trail alongside order.giftCardAmount (the snapshot on the order itself).
// A refund crediting balance back to the card does NOT create a row here
// (that would conflate "money spent" with "money credited back"); it's
// recorded on orderreturn.giftCardRefundAmount instead, against the same
// order this redemption references — see ReturnsService.
model giftcardredemption {
  id         Int      @id @default(autoincrement())
  giftCardId Int
  orderId    Int
  amountUsed Decimal
  createdAt  DateTime @default(now())
  giftcard   giftcard @relation(fields: [giftCardId], references: [id], onDelete: Cascade, map: "GiftCardRedemption_giftCardId_fkey")
  order      order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "GiftCardRedemption_orderId_fkey")

  @@index([giftCardId], map: "GiftCardRedemption_giftCardId_fkey")
  @@index([orderId], map: "GiftCardRedemption_orderId_fkey")
}
