# Copy to .env and fill in real values. Never commit .env itself (see
# .gitignore) — this file exists so every env var the app reads is
# enumerated in one place, with no real credentials.
#
# Required at boot (see common/env-validation.ts) — the app refuses to
# start with a clear error naming the var if any of these three are
# missing or malformed. Everything else below is optional, with a working
# fallback already in the code; env-validation.ts still checks their shape
# if you do set them.

# MySQL connection string. Percent-encode special characters in the
# password (e.g. `#` -> `%23`, `@` -> `%40`) — an unescaped character
# silently breaks the connection string.
DATABASE_URL=mysql://user:password@localhost:3306/shop_manager

# Signs/verifies staff and customer JWTs (see auth.module.ts,
# customer-auth.module.ts). Rotate before this ever runs anywhere but a
# local machine.
JWT_SECRET=dev-only-insecure-secret-change-before-deploy

# Encrypts per-shop payment/WhatsApp credentials at rest (see
# common/crypto.ts). Rotate before this ever runs anywhere but a local
# machine — rotating in a real deployment requires re-encrypting every
# shop's saved credentials, there's no built-in key-rotation tool today.
CREDENTIAL_ENCRYPTION_KEY=dev-only-insecure-credential-key-change-before-deploy

# --- Optional, with working defaults in code ---

# HTTP port the NestJS server listens on. Defaults to 3000 if unset.
PORT=3000

# development | production | test. Jest sets this to `test` automatically;
# never set it to `test` yourself outside that context (it disables rate
# limiting — see app.module.ts's ThrottlerModule.forRoot skipIf).
NODE_ENV=development

# Comma-separated CORS allowlist for the admin panel + storefront origins.
# Defaults to the two local dev ports if unset.
ADMIN_ORIGINS=http://localhost:3001,http://localhost:3002

# Base URL of the admin app — password-reset/email-verification/staff-
# invite links point at "<this>/reset-password?token=...", etc. Defaults to
# http://localhost:3001 if unset.
ADMIN_URL=http://localhost:3001

# Base URL of the storefront app — payment links and customer password-
# reset links point at "<this>/pay/:token" and "<this>/<shopSlug>/...".
# Defaults to http://localhost:3002 if unset.
STOREFRONT_URL=http://localhost:3002

# Webhook URL the global exception filter POSTs captured unhandled errors
# to (see common/error-tracking/). No vendor-specific format required — any
# endpoint that accepts a JSON POST works, including Sentry's own generic
# webhook ingestion. Unset = no-op (errors are still logged to stdout via
# the structured logger, just not forwarded anywhere external).
ERROR_TRACKING_WEBHOOK_URL=

# --- Email (common/email.ts) — platform-level, not per-shop ---

# Resend API key. Unset, or the reserved sentinel value 'test', both
# short-circuit to sendEmailStub() (logs instead of sending) — 'test' is
# what this repo's own dev/CI env uses so the e2e suite never makes a real,
# slow, always-failing network call to Resend.
RESEND_API_KEY=test

# --- Payments — one platform-level fallback per gateway, used only when a
# shop hasn't configured its own credentials via Settings > Payments (see
# PaymentSettingsService.resolveCredentials) ---

# Stripe (the only gateway with a fully real integration + real webhook
# handling today).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Tabby (real integration).
TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_WEBHOOK_SECRET=

# Tamara (real integration).
TAMARA_API_URL=https://api-sandbox.tamara.co
TAMARA_TOKEN=
TAMARA_NOTIFICATION_TOKEN=

# Telr / PayTabs / Nomod / PayPal are structural stubs today (see
# CLAUDE.md's "Payments use a strategy pattern" section) — no real
# credential is read from the environment for any of them yet. Listed here
# for when one of them gets a real implementation, matching the pattern the
# four real gateways above already follow.
TELR_STORE_ID=
TELR_AUTH_KEY=
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=

# --- File storage (src/storage/) — image uploads (products, categories,
# collections, ingredients, theme, bio-links, shop, seo, scan). Local disk
# by default; existing files/URLs keep working unchanged either way, and
# nothing here is migrated automatically when you switch providers (see the
# Phase 6 report's migration steps). ---

# local (default) | s3. "s3" works against AWS S3 or any S3-compatible
# endpoint (Cloudflare R2, MinIO, ...) via the S3_* vars below — all five
# are required when this is "s3", checked at boot, not on first upload.
STORAGE_PROVIDER=local

# Max upload size in MB, enforced both by multer (stops an oversized file
# from ever fully buffering) and again inside StorageService. Defaults to
# 10 if unset.
MAX_UPLOAD_SIZE_MB=10

# Required only when STORAGE_PROVIDER=s3. S3_ENDPOINT is the full base URL
# of the S3-compatible API (e.g. https://<account>.r2.cloudflarestorage.com
# for R2, http://localhost:9000 for a local MinIO, or
# https://s3.<region>.amazonaws.com for real AWS S3) — used with path-style
# addressing (<endpoint>/<bucket>/<key>) so the same config shape works
# across providers.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
