# CI-only env file — dummy values, no real credentials, no real network calls.
# Copied to backend/.env by .github/workflows/ci.yml before migrations/tests
# run. Do not put real secrets here; this file is committed to the repo.

DATABASE_URL=mysql://shop_app:shop_app_pw@127.0.0.1:3306/shop_manager

JWT_SECRET=ci-dummy-jwt-secret-not-for-real-use
CREDENTIAL_ENCRYPTION_KEY=ci-dummy-encryption-key-not-for-real-use

ADMIN_ORIGINS=http://localhost:3001,http://localhost:3002
ADMIN_URL=http://localhost:3001
STOREFRONT_URL=http://localhost:3002

# 'test' is the reserved sentinel sendEmail() short-circuits on — no real
# Resend network call in CI, every email logs via sendEmailStub instead.
RESEND_API_KEY=test

# Payment gateways are resolved lazily per-shop/per-key (see
# PaymentProviderRegistry / PaymentSettingsService.resolveCredentials) — no
# checkout/webhook e2e spec exercises a real gateway network call, these
# just need to be non-empty so provider construction doesn't throw.
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
TABBY_PUBLIC_KEY=dummy_tabby_public
TABBY_SECRET_KEY=dummy_tabby_secret
TABBY_WEBHOOK_SECRET=dummy_tabby_webhook
TAMARA_API_URL=https://api.tamara.test
TAMARA_TOKEN=dummy_tamara_token
TAMARA_NOTIFICATION_TOKEN=dummy_tamara_notification_token
